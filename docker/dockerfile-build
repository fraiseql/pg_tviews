# Reproducible build environment for pg_tviews
FROM rust:1.91.1-slim-bookworm

# Install system dependencies
RUN apt-get update && apt-get install -y \
    # PostgreSQL repository setup
    wget \
    gnupg \
    lsb-release \
    && wget -qO- https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor > /usr/share/keyrings/postgresql-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/postgresql-keyring.gpg] http://apt.postgresql.org/pub/repos/apt $(lsb_release -cs)-pgdg main" > /etc/apt/sources.list.d/postgresql.list \
    && apt-get update

RUN apt-get install -y \
    # PostgreSQL 18 (matches the extension's default target)
    postgresql-18 \
    postgresql-server-dev-18 \
    # Essential build tools only
    build-essential \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Install pgrx pinned to the version the extension is built against.
RUN cargo install --locked cargo-pgrx --version 0.17.0

# Initialize pgrx with PostgreSQL 18
RUN cargo pgrx init --pg18 /usr/lib/postgresql/18/bin/pg_config

# Set up reproducible build environment
ENV SOURCE_DATE_EPOCH=1
ENV RUSTFLAGS="-C opt-level=3 -C debuginfo=0 -C strip=symbols -C relocation-model=pic -C link-arg=-Wl,-z,relro,-z,now -C link-arg=-Wl,-z,noexecstack -C embed-bitcode=no"
ENV CARGO_HOME=/usr/local/cargo
ENV RUSTUP_HOME=/usr/local/rustup

# Create build workspace
WORKDIR /build

# Copy source code
COPY . .

# Default command for reproducible builds: stage the packaged extension tree
# into /out (mount a host directory there to collect the artifacts).
CMD ["cargo", "pgrx", "package", \
     "--no-default-features", "--features", "pg18", \
     "--pg-config", "/usr/lib/postgresql/18/bin/pg_config", \
     "--out-dir", "/out"]